# Set these in Vercel > Project > Settings > Environment Variables (never commit real values)
ADMIN_PASSWORD_HASH=      # output of: npm run hash -- "your password"
SESSION_SECRET=           # random string, 32+ chars
GITHUB_TOKEN=             # fine-grained token, ONLY this website repo, Contents: read/write
GITHUB_REPO=              # e.g. codertheashish/jini-ai-website
GITHUB_BRANCH=main

# Website accounts (optional)
GOOGLE_CLIENT_ID=          # Google Cloud Console > Credentials > OAuth client (Web)
GOOGLE_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=    # free Upstash Redis (or Vercel Marketplace; KV_REST_API_URL also works)
UPSTASH_REDIS_REST_TOKEN=
